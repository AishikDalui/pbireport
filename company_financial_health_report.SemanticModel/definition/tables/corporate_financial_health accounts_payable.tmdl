	measure DSO = ```
			
			VAR LatestDate =
			    MAX('corporate_financial_health balance_sheet'[end])
			VAR PreviousDate =
			    CALCULATE(
			        MAX('corporate_financial_health balance_sheet'[end]),
			        FILTER(
			            ALL('corporate_financial_health balance_sheet'[end]),
			            'corporate_financial_health balance_sheet'[end] < LatestDate
			        )
			    )
			VAR CurrentAR =
			    CALCULATE(
			        SUM('corporate_financial_health balance_sheet'[accounts_receivable]),
			        'corporate_financial_health balance_sheet'[end] = LatestDate
			    )
			VAR PreviousAR =
			    CALCULATE(
			        SUM('corporate_financial_health balance_sheet'[accounts_receivable]),
			        'corporate_financial_health balance_sheet'[end] = PreviousDate
			    )
			VAR AnnualRevenue =
			    CALCULATE(
			        SUM('corporate_financial_health income_statement'[revenue]),
			        'corporate_financial_health income_statement'[end] = LatestDate
			    )
			VAR AverageAR =
			    DIVIDE(CurrentAR + PreviousAR, 2)
			RETURN
			    DIVIDE(AverageAR, AnnualRevenue) * 365
			
			```
		lineageTag: 797c2034-5342-4476-9abc-23f2d5237dd5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DIO = ```
			
			VAR LatestDate =
			    MAX('corporate_financial_health balance_sheet'[end])
			VAR PreviousDate =
			    CALCULATE(
			        MAX('corporate_financial_health balance_sheet'[end]),
			        FILTER(
			            ALL('corporate_financial_health balance_sheet'[end]),
			            'corporate_financial_health balance_sheet'[end] < LatestDate
			        )
			    )
			VAR CurrentInventory =
			    CALCULATE(
			        SUM('corporate_financial_health balance_sheet'[inventory]),
			        'corporate_financial_health balance_sheet'[end] = LatestDate
			    )
			VAR PreviousInventory =
			    CALCULATE(
			        SUM('corporate_financial_health balance_sheet'[inventory]),
			        'corporate_financial_health balance_sheet'[end] = PreviousDate
			    )
			VAR AnnualCOGS =
			    CALCULATE(
			        SUM('corporate_financial_health income_statement'[cogs]),
			        'corporate_financial_health income_statement'[end] = LatestDate
			    )
			VAR AverageInventory =
			    DIVIDE(CurrentInventory + PreviousInventory, 2)
			RETURN
			    DIVIDE(AverageInventory, AnnualCOGS) * 365
			
			
			```
		lineageTag: 54b9e70f-00c2-45f7-8fc4-b2e428427e9f

