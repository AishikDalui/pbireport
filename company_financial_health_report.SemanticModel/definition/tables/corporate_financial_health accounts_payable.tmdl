	measure 'Latest FY Net Margin %' = ```
			
			DIVIDE(
			    [Latest FY Net Income],
			    [Latest FY Revenue],
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 92acb8fa-afd9-4e39-8557-ad372a1032eb

	measure 'Latest FY Gross Margin %' = ```
			
			VAR LatestDate =
			    CALCULATE(
			        MAX('corporate_financial_health income_statement'[end]),
			        REMOVEFILTERS('corporate_financial_health income_statement')
			    )
			RETURN
			    CALCULATE(
			        DIVIDE(
			            SUM('corporate_financial_health income_statement'[gross_profit]),
			            SUM('corporate_financial_health income_statement'[revenue]),
			            0
			        ),
			        'corporate_financial_health income_statement'[end] = LatestDate
			    )
			
			```
