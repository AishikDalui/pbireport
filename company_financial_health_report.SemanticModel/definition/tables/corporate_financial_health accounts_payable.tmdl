	measure DPO = ```
			
			VAR LatestAPDate =
			    MAXX(
			        ALL('corporate_financial_health accounts_payable'),
			        'corporate_financial_health accounts_payable'[end]
			    )
			VAR PreviousAPDate =
			    MAXX(
			        FILTER(
			            ALL('corporate_financial_health accounts_payable'),
			            'corporate_financial_health accounts_payable'[end] < LatestAPDate
			        ),
			        'corporate_financial_health accounts_payable'[end]
			    )
			VAR CurrentAP =
			    CALCULATE(
			        SUM('corporate_financial_health accounts_payable'[accounts_payable]),
			        REMOVEFILTERS('corporate_financial_health accounts_payable'),
			        'corporate_financial_health accounts_payable'[end] = LatestAPDate
			    )
			VAR PreviousAP =
			    CALCULATE(
			        SUM('corporate_financial_health accounts_payable'[accounts_payable]),
			        REMOVEFILTERS('corporate_financial_health accounts_payable'),
			        'corporate_financial_health accounts_payable'[end] = PreviousAPDate
			    )
			VAR AverageAP =
			    DIVIDE(CurrentAP + PreviousAP, 2)
			VAR AnnualCOGS =
			    [Test Latest COGS Simple]
			RETURN
			    DIVIDE(AverageAP, AnnualCOGS) * 365
			
			```
