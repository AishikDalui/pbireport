table 'corporate_financial_health cash_flow'
	lineageTag: 344632af-54c9-4917-9426-9ef77b92c215

	measure 'Latest FY Operating Cash Flow' = ```
			
			VAR LatestDate =
			    CALCULATE(
			        MAX('corporate_financial_health cash_flow'[end]),
			        REMOVEFILTERS('corporate_financial_health cash_flow')
			    )
			RETURN
			    CALCULATE(
			        SUM('corporate_financial_health cash_flow'[operating_cash_flow]),
			        REMOVEFILTERS('corporate_financial_health cash_flow'),
			        'corporate_financial_health cash_flow'[end] = LatestDate
			    )
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 2248e321-2645-462c-af63-6b43ed2ab561

	measure Latest_FY_Net_Income = ```
			
			VAR LatestDate =
			    CALCULATE(
			        MAX('corporate_financial_health cash_flow'[end]),
			        REMOVEFILTERS('corporate_financial_health cash_flow')
			    )
			RETURN
			    CALCULATE(
			        SUM('corporate_financial_health cash_flow'[net_income]),
			        REMOVEFILTERS('corporate_financial_health cash_flow'),
			        'corporate_financial_health cash_flow'[end] = LatestDate
			    )
			
			```
		formatString: 0
		lineageTag: 025a1392-dff7-4da6-81bb-eaa3f4d1f093

	measure 'Latest FY Cash Conversion Ratio' = DIVIDE([Latest FY Operating Cash Flow], [Latest FY Net Income])
		formatString: 0.000
		lineageTag: 8cae95eb-c439-41e3-8473-b615623702c5

	measure 'Latest FY Cash Flow vs Net Income Gap' = ```
			
			[Latest FY Operating Cash Flow] - [Latest FY Net Income]
			
			```
		formatString: 0.00
		lineageTag: 82e86113-0df9-46b8-a708-4c829930160c

